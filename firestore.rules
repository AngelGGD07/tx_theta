rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isVerifiedUser() {
      return request.auth != null
        && (
          request.auth.token.firebase.sign_in_provider != 'password'
          || request.auth.token.email_verified == true
        );
    }

    function isOwner(userId) {
      return isVerifiedUser()
        && request.auth.uid == userId;
    }

    function validResponsibilityKeys() {
      return request.resource.data.keys().hasOnly([
        'userId',
        'type',
        'subject',
        'description',
        'createdAt',
        'dueAt',
        'predictedStartAt',
        'predictionStatus',
        'startedAt',
        'startSource',
        'activeStartEventId',
        'completedAt',
        'submittedAt',
        'status'
      ]);
    }

    function validStartEventKeys() {
      return request.resource.data.keys().hasAll([
        'eventId',
        'userId',
        'responsibilityId',
        'type',
        'startedAt',
        'startSource',
        'recordedAt'
      ])
      && request.resource.data.keys().hasOnly([
        'eventId',
        'userId',
        'responsibilityId',
        'type',
        'startedAt',
        'startSource',
        'recordedAt'
      ]);
    }

    function validUndoEventKeys() {
      return request.resource.data.keys().hasAll([
        'eventId',
        'userId',
        'responsibilityId',
        'type',
        'startEventId',
        'undoneAt'
      ])
      && request.resource.data.keys().hasOnly([
        'eventId',
        'userId',
        'responsibilityId',
        'type',
        'startEventId',
        'undoneAt'
      ]);
    }

    function validNotStartedKeys() {
      return request.resource.data.keys().hasAll([
        'eventId',
        'userId',
        'responsibilityId',
        'predictedAt',
        'predictedStartAt',
        'response',
        'respondedAt'
      ])
      && request.resource.data.keys().hasOnly([
        'eventId',
        'userId',
        'responsibilityId',
        'predictedAt',
        'predictedStartAt',
        'response',
        'respondedAt'
      ]);
    }

    function validPredictionCorrectedKeys() {
      return request.resource.data.keys().hasAll([
        'eventId',
        'userId',
        'responsibilityId',
        'predictedAt',
        'predictedStartAt',
        'response',
        'respondedAt',
        'previousDueAt',
        'newDueAt',
        'previousPredictedStartAt',
        'newPredictedStartAt',
        'previousPredictionStatus',
        'newPredictionStatus'
      ])
      && request.resource.data.keys().hasOnly([
        'eventId',
        'userId',
        'responsibilityId',
        'predictedAt',
        'predictedStartAt',
        'response',
        'respondedAt',
        'previousDueAt',
        'newDueAt',
        'previousPredictedStartAt',
        'newPredictedStartAt',
        'previousPredictionStatus',
        'newPredictionStatus'
      ]);
    }

    function validNotificationEventKeys() {
      return request.resource.data.keys().hasOnly([
        'userId',
        'responsibilityId',
        'type',
        'at',
        'actionSelected'
      ]);
    }

    function validConsentKeys() {
      return request.resource.data.keys().hasOnly([
        'userId',
        'consentVersion',
        'appVersion',
        'accepted',
        'acceptedAt',
        'withdrawnAt',
        'locale'
      ]);
    }

    function isValidStartSource(src) {
      return src in [
        'manualLive',
        'manualRecalled',
        'reminderLive',
        'reminderRecalled'
      ];
    }

    function validRegularResponsibilityUpdate() {
      return validResponsibilityKeys()
        && resource.data.status != 'discarded'
        && request.resource.data.status != 'discarded'
        && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly([
              'type',
              'subject',
              'description',
              'dueAt',
              'predictedStartAt',
              'predictionStatus'
            ]);
    }

    function validDiscardUpdate(docId) {
      let notYetId = 'not_yet_' + docId;

      return resource.data.status == 'pending'
        && resource.data.startedAt == null
        && request.resource.data.status == 'discarded'
        && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly(['status'])
        && !exists(
          /databases/$(database)/documents/prediction_events/$(notYetId)
        );
    }

    function validStartTransition(docId) {
      return resource.data.status == 'pending'
        && resource.data.startedAt == null
        && (!resource.data.keys().hasAny(['activeStartEventId'])
            || resource.data.activeStartEventId == null)
        && request.resource.data.status == 'started'
        && request.resource.data.startedAt is timestamp
        && isValidStartSource(request.resource.data.startSource)
        && request.resource.data.activeStartEventId is string
        && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly([
              'status',
              'startedAt',
              'startSource',
              'activeStartEventId'
            ])
        && getAfter(
          /databases/$(database)/documents/prediction_events/
              $(request.resource.data.activeStartEventId)
        ).data.eventId == request.resource.data.activeStartEventId
        && getAfter(
          /databases/$(database)/documents/prediction_events/
              $(request.resource.data.activeStartEventId)
        ).data.userId == request.auth.uid
        && getAfter(
          /databases/$(database)/documents/prediction_events/
              $(request.resource.data.activeStartEventId)
        ).data.responsibilityId == docId
        && getAfter(
          /databases/$(database)/documents/prediction_events/
              $(request.resource.data.activeStartEventId)
        ).data.type == 'start_registered'
        && getAfter(
          /databases/$(database)/documents/prediction_events/
              $(request.resource.data.activeStartEventId)
        ).data.startedAt == request.resource.data.startedAt
        && getAfter(
          /databases/$(database)/documents/prediction_events/
              $(request.resource.data.activeStartEventId)
        ).data.startSource == request.resource.data.startSource;
    }

    function validUndoTransition(docId) {
      let undoEventId = 'undo_' + docId + '_' + resource.data.activeStartEventId;

      return resource.data.status == 'started'
        && resource.data.startedAt is timestamp
        && resource.data.activeStartEventId is string
        && request.resource.data.status == 'pending'
        && request.resource.data.startedAt == null
        && request.resource.data.startSource == null
        && request.resource.data.activeStartEventId == null
        && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly([
              'status',
              'startedAt',
              'startSource',
              'activeStartEventId'
            ])
        && getAfter(
          /databases/$(database)/documents/prediction_events/$(undoEventId)
        ).data.eventId == undoEventId
        && getAfter(
          /databases/$(database)/documents/prediction_events/$(undoEventId)
        ).data.userId == request.auth.uid
        && getAfter(
          /databases/$(database)/documents/prediction_events/$(undoEventId)
        ).data.responsibilityId == docId
        && getAfter(
          /databases/$(database)/documents/prediction_events/$(undoEventId)
        ).data.type == 'start_undone'
        && getAfter(
          /databases/$(database)/documents/prediction_events/$(undoEventId)
        ).data.startEventId == resource.data.activeStartEventId;
    }

    match /responsibilities/{docId} {
      allow read: if isOwner(resource.data.userId);

      allow create: if isVerifiedUser()
        && request.resource.data.userId == request.auth.uid
        && validResponsibilityKeys();

      allow update: if isVerifiedUser()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && (
          validRegularResponsibilityUpdate()
          || validDiscardUpdate(docId)
          || validStartTransition(docId)
          || validUndoTransition(docId)
        );

      allow delete: if false;
    }

    match /prediction_events/{docId} {
      allow get: if isVerifiedUser()
        && (
          !exists(
            /databases/$(database)/documents/prediction_events/$(docId)
          )
          || resource.data.userId == request.auth.uid
        );

      allow list: if false;

      allow create: if isVerifiedUser()
        && request.resource.data.userId == request.auth.uid
        && (
          // not_started
          (
            validNotStartedKeys()
            && request.resource.data.response == 'not_started'
            && request.resource.data.eventId == docId
            && docId == 'not_yet_' + request.resource.data.responsibilityId
            && getAfter(
              /databases/$(database)/documents/responsibilities/
                  $(request.resource.data.responsibilityId)
            ).data.userId == request.auth.uid
            && getAfter(
              /databases/$(database)/documents/responsibilities/
                  $(request.resource.data.responsibilityId)
            ).data.status == 'pending'
            && getAfter(
              /databases/$(database)/documents/responsibilities/
                  $(request.resource.data.responsibilityId)
            ).data.startedAt == null
            && (!getAfter(
              /databases/$(database)/documents/responsibilities/
                  $(request.resource.data.responsibilityId)
            ).data.keys().hasAny(['activeStartEventId'])
                || getAfter(
                  /databases/$(database)/documents/responsibilities/
                      $(request.resource.data.responsibilityId)
                ).data.activeStartEventId == null)
            && getAfter(
              /databases/$(database)/documents/responsibilities/
                  $(request.resource.data.responsibilityId)
            ).data.createdAt == request.resource.data.predictedAt
            && getAfter(
              /databases/$(database)/documents/responsibilities/
                  $(request.resource.data.responsibilityId)
            ).data.predictedStartAt == request.resource.data.predictedStartAt
          )
          ||
          // prediction_corrected
          (
            validPredictionCorrectedKeys()
            && request.resource.data.response == 'prediction_corrected'
            && request.resource.data.eventId == docId
            && request.resource.data.previousPredictionStatus
                in ['declared', 'unknown']
            && request.resource.data.newPredictionStatus
                in ['declared', 'unknown']
            && request.resource.data.predictedAt is timestamp
            && request.resource.data.respondedAt is timestamp
            && request.resource.data.previousDueAt is timestamp
            && request.resource.data.newDueAt is timestamp
            && (
              (
                request.resource.data.newPredictionStatus == 'declared'
                && request.resource.data.newPredictedStartAt is timestamp
                && request.resource.data.predictedStartAt
                    == request.resource.data.newPredictedStartAt
              )
              ||
              (
                request.resource.data.newPredictionStatus == 'unknown'
                && request.resource.data.newPredictedStartAt == null
                && request.resource.data.predictedStartAt == null
              )
            )
            && (
              (
                request.resource.data.previousPredictionStatus == 'declared'
                && request.resource.data.previousPredictedStartAt is timestamp
              )
              ||
              (
                request.resource.data.previousPredictionStatus == 'unknown'
                && request.resource.data.previousPredictedStartAt == null
              )
            )
            && (
              request.resource.data.newPredictionStatus == 'unknown'
              || request.resource.data.newDueAt
                  > request.resource.data.newPredictedStartAt
            )
          )
          ||
          // start_registered
          (
            validStartEventKeys()
            && request.resource.data.type == 'start_registered'
            && request.resource.data.eventId == docId
            && request.resource.data.startedAt is timestamp
            && request.resource.data.recordedAt is timestamp
            && isValidStartSource(request.resource.data.startSource)
            && getAfter(
              /databases/$(database)/documents/responsibilities/
                  $(request.resource.data.responsibilityId)
            ).data.userId == request.auth.uid
            && getAfter(
              /databases/$(database)/documents/responsibilities/
                  $(request.resource.data.responsibilityId)
            ).data.status == 'started'
            && getAfter(
              /databases/$(database)/documents/responsibilities/
                  $(request.resource.data.responsibilityId)
            ).data.activeStartEventId == docId
            && getAfter(
              /databases/$(database)/documents/responsibilities/
                  $(request.resource.data.responsibilityId)
            ).data.startedAt == request.resource.data.startedAt
            && getAfter(
              /databases/$(database)/documents/responsibilities/
                  $(request.resource.data.responsibilityId)
            ).data.startSource == request.resource.data.startSource
          )
          ||
          // start_undone
          (
            validUndoEventKeys()
            && request.resource.data.type == 'start_undone'
            && request.resource.data.eventId == docId
            && request.resource.data.startEventId is string
            && request.resource.data.undoneAt is timestamp
            && docId == 'undo_' + request.resource.data.responsibilityId + '_'
                + request.resource.data.startEventId
            && existsAfter(
              /databases/$(database)/documents/prediction_events/
                  $(request.resource.data.startEventId)
            )
            && getAfter(
              /databases/$(database)/documents/responsibilities/
                  $(request.resource.data.responsibilityId)
            ).data.userId == request.auth.uid
            && getAfter(
              /databases/$(database)/documents/responsibilities/
                  $(request.resource.data.responsibilityId)
            ).data.status == 'pending'
            && getAfter(
              /databases/$(database)/documents/responsibilities/
                  $(request.resource.data.responsibilityId)
            ).data.startedAt == null
            && getAfter(
              /databases/$(database)/documents/responsibilities/
                  $(request.resource.data.responsibilityId)
            ).data.startSource == null
            && getAfter(
              /databases/$(database)/documents/responsibilities/
                  $(request.resource.data.responsibilityId)
            ).data.activeStartEventId == null
          )
        );

      allow update: if false;
      allow delete: if false;
    }

    match /notification_events/{docId} {
      allow read: if isOwner(resource.data.userId);

      allow create: if isVerifiedUser()
        && request.resource.data.userId == request.auth.uid
        && validNotificationEventKeys();

      allow update: if false;
      allow delete: if false;
    }

    match /pilot_consents/{userId} {
      allow read: if isVerifiedUser()
        && request.auth.uid == userId;

      allow create: if isVerifiedUser()
        && request.auth.uid == userId
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.consentVersion == 'pilot_2026_01'
        && request.resource.data.appVersion == '1.0.0+2'
        && request.resource.data.accepted == true
        && request.resource.data.acceptedAt == request.time
        && request.resource.data.withdrawnAt == null
        && request.resource.data.locale is string
        && validConsentKeys();

      allow update: if isVerifiedUser()
        && userId == request.auth.uid
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.consentVersion == 'pilot_2026_01'
        && request.resource.data.appVersion == '1.0.0+2'
        && request.resource.data.accepted == true
        && request.resource.data.acceptedAt == request.time
        && request.resource.data.withdrawnAt == null
        && request.resource.data.locale is string
        && validConsentKeys();

      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}